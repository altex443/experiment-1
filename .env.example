# Server only. Copy to .env and enter your real values there.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rep
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
HOST=127.0.0.1
PORT=3001
# Public frontend URL only. NEVER put credentials in VITE_* variables.
# VITE_API_URL=https://your-api.example.com
# debug, info, warn, error, or silent. Default info.
LOG_LEVEL=info

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters


# Optional: use only if your network has IPv6 connectivity problems.
# MONGODB_IP_FAMILY=4
