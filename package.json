{
  "name": "rep-training",
  "version": "1.0.0",
  "description": "Minimal phone-friendly workout tracker for GitHub Pages",
  "repository": {
    "type": "git",
    "url": "exp1"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"node --watch index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:watch": "concurrently -k \"tsc --noEmit --watch --preserveWatchOutput\" \"vite build --watch\"",
    "start": "node index.js",
    "test": "node --test",
    "preview": "vite preview --host 127.0.0.1",
    "dev:client": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.17.0",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "vite": "^6.3.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
